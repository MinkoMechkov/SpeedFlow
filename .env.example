# Demo mode (default when Supabase URL/key missing). Set true to force in-memory demo auth/data.
DEMO_MODE=true

# Supabase (required when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# App URL for auth email redirects (password reset). Defaults to request origin.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127

# Optional: Gemini invoice extraction (mock fallback when unset)
GEMINI_API_KEY=
# Prefer flash-lite for speed; gemini-3.8-flash is slower / often congested
GEMINI_MODEL=gemini-3.1-flash-lite
