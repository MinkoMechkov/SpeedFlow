# Demo mode (default when Supabase URL/key missing). Set true to force in-memory demo auth/data.
DEMO_MODE=true

# Supabase (required when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: real LLM extraction (mock fallback when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
